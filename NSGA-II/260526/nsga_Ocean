        )
        plt.plot(
            res_t["p_cost"],
            res_t["p_Ao"],
            linewidth=1.2,
            alpha=0.72,
            color=color
        )

    ylim = _dynamic_limits(all_ao + AO_LINES, low_q=1.0, high_q=99.0, pad_ratio=0.12, min_span=0.002)
