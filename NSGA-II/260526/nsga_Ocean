def _finite_series(values):
    arr = np.asarray(values, dtype=float)
    return arr[np.isfinite(arr)]


def _dynamic_limits(values, low_q=2.0, high_q=98.0, pad_ratio=0.08, min_span=1e-6):
    """Return robust axis limits with padding for presentation plots."""
    finite = _finite_series(values)
    if finite.size == 0:
        return None

    lo = float(np.nanpercentile(finite, low_q))
    hi = float(np.nanpercentile(finite, high_q))

    if not np.isfinite(lo) or not np.isfinite(hi):
        return None
    if abs(hi - lo) < min_span:
        center = 0.5 * (lo + hi)
        span = max(abs(center) * 0.02, min_span)
        return center - span, center + span

    span = hi - lo
    return lo - pad_ratio * span, hi + pad_ratio * span


def _format_cost_axis():
    """Format KRW axis in a compact, readable way."""
    ax = plt.gca()
    ax.ticklabel_format(axis="x", style="plain")


def _annotate_ao_range(values):
    finite = _finite_series(values)
    if finite.size == 0:
        return
    ao_min = float(np.nanmin(finite))
    ao_max = float(np.nanmax(finite))
    delta_bp = (ao_max - ao_min) * 10000.0
    plt.text(
        0.02,
        0.02,
        f"Ao range: {ao_min:.4f} ~ {ao_max:.4f} | Δ={delta_bp:.1f} bp",
        transform=plt.gca().transAxes,
        fontsize=9,
        bbox=dict(boxstyle="round,pad=0.3", facecolor="white", alpha=0.75, edgecolor="lightgray")
    )


def plot_representative_pareto(res_single):
    """
    Representative target Pareto plot.

    This plot keeps the original cost-Ao Pareto message but uses a dynamic
    Ao zoom window so the C-E curve is visually meaningful in the high-Ao range.
    """
    plt.figure(figsize=(10, 6))

    plt.scatter(
        res_single["cost"][res_single["dominated_idx"]],
        res_single["Ao"][res_single["dominated_idx"]],
        s=18,
        alpha=0.30,
        color="gray",
        label="Dominated solutions"
    )

    plt.scatter(
        res_single["p_cost"],
        res_single["p_Ao"],
        s=38,
        alpha=0.95,
        color="#1E88E5",
        label="Pareto solutions"
    )
    plt.plot(
        res_single["p_cost"],
        res_single["p_Ao"],
        linewidth=2.5,
        color="#1E88E5",
        label="Pareto C-E curve"
    )

    ao_values = np.concatenate([
        np.asarray(res_single["Ao"], dtype=float),
        np.asarray(AO_LINES, dtype=float),
        np.asarray([res_single["target_ao"]], dtype=float),
    ])
    ylim = _dynamic_limits(ao_values, low_q=1.0, high_q=99.0, pad_ratio=0.10, min_span=0.002)
    if ylim is not None:
        plt.ylim(*ylim)

    for ao_line in AO_LINES:
        if ylim is not None and not (ylim[0] <= ao_line <= ylim[1]):
            continue
        color = "#2E7D32" if ao_line < res_single["target_ao"] else "#6A1B9A"
        style = "--" if ao_line < res_single["target_ao"] else "-."
        plt.axhline(
            ao_line,
            linestyle=style,
            linewidth=1.1,
            color=color,
            alpha=0.85
        )
        plt.text(
            x=np.nanmin(res_single["cost"]) * 1.001,
            y=ao_line,
            s=f"Ao={ao_line:.2f}",
            fontsize=8,
            color=color,
            va="bottom"
        )

    _annotate_ao_range(res_single["Ao"])
    _format_cost_axis()
    plt.xlabel("Total Cost (KRW)")
    plt.ylabel("Ao (zoomed)")
    plt.title(f"Representative C-E Curve: Cost vs Ao, zoomed (target={res_single['target_ao']:.2f})")
    plt.grid(True, alpha=0.25)
    plt.legend(loc="best")
    plt.tight_layout()
    plt.show()


