    if ylim is not None:
        plt.ylim(*ylim)

    for ao_line in AO_LINES:
        ao_line_pct = ao_line * 100.0
        if ylim is not None and not (ylim[0] <= ao_line_pct <= ylim[1]):
            continue
        plt.axhline(
            ao_line_pct,
            linestyle="--",
            linewidth=0.9,
            alpha=0.45
        )

    _format_cost_axis()
    plt.xlabel("Total Cost (KRW)")
    plt.ylabel("Ao (%) zoomed")
    plt.title("Integrated C-E Trade-off Map: Cost vs Ao (%)")
    plt.grid(True, alpha=0.25)
    plt.colorbar(sc, label="Target Ao")
    plt.legend(loc="best")
    plt.tight_layout()
    plt.show()


def plot_cost_effectiveness_ao_gain(df_unique):
    """
    Cost-effectiveness curve using Ao gain from the minimum-cost solution.

    Ao itself is compressed near 1.0, so this plot converts the same result into
    basis points. Example: Ao +0.0050 is shown as +50 bp.
    """
    if df_unique.empty:
        print("No integrated solutions to plot.")
        return

    base_idx = df_unique["total_cost"].idxmin()
    base_ao = float(df_unique.loc[base_idx, "Ao"])

    df_plot = df_unique.copy()
    df_plot["ao_gain_bp"] = (df_plot["Ao"] - base_ao) * 10000.0
    df_plot = df_plot.sort_values("total_cost").reset_index(drop=True)

    plt.figure(figsize=(10, 6))
    sc = plt.scatter(
        df_plot["total_cost"],
        df_plot["ao_gain_bp"],
        c=df_plot["target_ao"],
        s=30,
        alpha=0.78
    )

    if len(df_plot) >= 5:
        window = max(3, min(15, len(df_plot) // 8))
        if window % 2 == 0:
            window += 1
        smooth_gain = df_plot["ao_gain_bp"].rolling(window=window, center=True, min_periods=1).median()
        plt.plot(
            df_plot["total_cost"],
            smooth_gain,
            linewidth=2.4,
            color="#111111",
            alpha=0.78,
            label="Median C-E trend"
        )

    plt.axhline(0.0, linestyle="--", linewidth=1.0, color="gray", alpha=0.65)
    _format_cost_axis()
    plt.xlabel("Total Cost (KRW)")
    plt.ylabel("Ao improvement from minimum-cost solution (basis points)")
    plt.title("C-E Curve: Incremental Ao gain per cost")
    plt.grid(True, alpha=0.25)
    plt.colorbar(sc, label="Target Ao")
    plt.legend(loc="best")
    plt.tight_layout()
    plt.show()


